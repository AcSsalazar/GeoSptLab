# SPT Parameters Calculator Backend Configuration

# Application settings
SECRET_KEY=your-very-secure-secret-key-change-this-in-production
DEBUG=True
APP_NAME=SPT Parameters Calculator API
APP_VERSION=1.0.0

# Database settings (PostgreSQL recommended for production)
DATABASE_URL=postgresql://postgres:12345@localhost:5432/consuldb
# For SQLite development:
# DATABASE_URL=sqlite:///./spt_calculator.db

# Email settings (optional)
EMAIL_HOST=localhost
EMAIL_PORT=25

# API settings
API_V1_STR=/api/v1

# CORS settings for frontend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*
