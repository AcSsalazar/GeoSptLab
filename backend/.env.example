# ===========================================
# GeoSptLab Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Application settings
SECRET_KEY=your-very-secure-secret-key-change-this-in-production
DEBUG=False  # Set to True only in development
APP_NAME=GeoSptLab
APP_VERSION=0.1.1

# Database settings
# For local development with PostgreSQL:
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# For Render (they provide this automatically, note: Render uses postgres:// but our app handles it):
# DATABASE_URL=postgres://user:password@host:port/database

# Email settings (optional)
EMAIL_HOST=localhost
EMAIL_PORT=25

# API settings
API_V1_STR=/api/v1

# CORS settings for frontend (JSON array format)
# For development:
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://127.0.0.1:5173"]
# For production (replace with your actual frontend URLs):
# ALLOWED_ORIGINS=["https://your-frontend.vercel.app", "https://geosptlab.tech"]

ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
ALLOWED_HEADERS=["*"]
