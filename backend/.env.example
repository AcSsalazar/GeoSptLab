# Application Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
APP_NAME=SPT ConsulCivil API
APP_VERSION=1.0.0

# Database Configuration
DATABASE_URL=sqlite:///./spt_app.db
# For PostgreSQL use: postgresql://username:password@localhost/database_name
# For MySQL use: mysql://username:password@localhost/database_name

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration  
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

